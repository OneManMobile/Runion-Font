languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem runr dflt;
feature liga {
    sub tiwaz [hagalaz hagalaz.cap] by thurisaz;
    sub tiwaz.cap [hagalaz hagalaz.cap] by thurisaz.cap;
    sub naudiz [gebo gebo.cap] by ingwaz;
    sub naudiz.cap [gebo gebo.cap] by ingwaz.cap;
    sub ansuz [ansuz ansuz.cap] by aring;
    sub ansuz.cap [ansuz ansuz.cap] by aring.cap;
} liga;
feature ss01 {
    featureNames { name "Nordic sound-runes"; };
    sub uni00FC  by eihwaz;
    sub uni00DC  by eihwaz.cap;
    sub uni00E4  by ae;
    sub uni00C4  by ae.cap;
    sub ansuz [ehwaz ehwaz.cap] by ae;
    sub ansuz.cap [ehwaz ehwaz.cap] by ae.cap;
    sub uni00F6  by oslash;
    sub uni00D6  by oslash.cap;
    sub othala [ehwaz ehwaz.cap] by oslash;
    sub othala.cap [ehwaz ehwaz.cap] by oslash.cap;
} ss01;
markClass [uni0301 uni0300 uni0302 uni030C uni0303 uni0308 uni0304 uni0306 uni0307 uni030A uni030B] <anchor -200 820> @TOP;
markClass [uni0327 uni0328 uni0326] <anchor -200 -70> @BOTTOM;
